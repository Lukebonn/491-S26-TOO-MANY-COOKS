theme_override_font_sizes/normal_font_size = 9
text = "There could be rooms like this that have traps and other hazards in them. Player basically just has to carefully navigate through the room, likely to get to the other side. End of the room could lead to a side room that lets the player return back the way they came from without having to go through the traps again"
horizontal_alignment = 1
vertical_alignment = 1

