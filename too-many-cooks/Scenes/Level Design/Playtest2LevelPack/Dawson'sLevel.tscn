theme_override_font_sizes/normal_font_size = 9
text = "Different sized rooms, but most will be rectangular in shape.
Larger rooms could have environmental hazards thrown about."
horizontal_alignment = 1
vertical_alignment = 1

[node name="RichTextLabel5" type="RichTextLabel" parent="Labels" unique_id=1032009365]
