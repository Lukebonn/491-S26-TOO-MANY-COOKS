text = "Entry 4"
autowrap_mode = 2
script = ExtResource("20_q3h1k")
Locked = true
Title = "The Future"
Unlock_Goal = 5
Author = "Walter"
Body = "The cat made its way to the upper floors.  I do not know if I would have been able to do the same. But now that the cat has dealt with the Rat King, perhaps the crystal will be restored and with it, the blight on the land will be reversed.  I wonder if I could take homage in the tower, to keep it safe and to further my studies?"
