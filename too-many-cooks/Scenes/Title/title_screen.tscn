text = "Entry 3"
autowrap_mode = 2
script = ExtResource("20_q3h1k")
Locked = true
Title = "Curious Fellow"
Unlock_Goal = 3
Author = "Walter"
Body = "That funny little cat seems to be able to do everything.  They brought me, that warrior lion lady and a funny little raccoon to this old run town tavern that they seem to be renovating.  I must be honest, it has been awhile since I have had a meal this good.  Perhaps I can stay here awhile and rest, study what information I have right now.  Plus the little feline seems to be more than capable of handling themselves under my tutelage."
