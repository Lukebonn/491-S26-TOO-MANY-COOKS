[node name="entry1" type="Button" parent="Journals/TabContainer/Rogue/Entries" unique_id=1274171343 node_paths=PackedStringArray("journal_text_ref", "journal_author_ref", "journal_panel_ref", "clickSound", "hoverSound")]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("7_xruoh")
theme_override_font_sizes/font_size = 32
text = "Entry 1"
autowrap_mode = 2
script = ExtResource("20_q3h1k")
Locked = true
Title = "Trash Pandas"
Author = "Renly"
Body = "\"Trash Panda\" this- \"Trash Panda\" that- I'm not some low class bin diving scum.  I have someone no one else does... class.  They say that tower is pretty heavily guarded huh?  Everything in there is just ancient relics that no one could be bothered to take.  Surely something in there will give me the acclaim I am seeking."
journal_text_ref = NodePath("../../../../../JournalPanel/JournalLabel")
journal_author_ref = NodePath("../../../../../JournalPanel/AuthorLabel")
journal_panel_ref = NodePath("../../../../../JournalPanel")
clickSound = NodePath("../../../../../ButtonClickSound")
hoverSound = NodePath("../../../../../ButtonHoverSound")
metadata/_custom_type_script = "uid://m1ratefdb4lj"

[node name="entry2" type="Button" parent="Journals/TabContainer/Rogue/Entries" unique_id=667653421 node_paths=PackedStringArray("journal_text_ref", "journal_author_ref", "journal_panel_ref", "clickSound", "hoverSound")]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("7_xruoh")
theme_override_font_sizes/font_size = 32
text = "Entry 2"
autowrap_mode = 2
script = ExtResource("20_q3h1k")
Locked = true
Title = "Crashout"
Unlock_Goal = 1
Author = "Renly"
Body = "That tower is supposed to be ABANDONED and now there are swarms of ARMED RATS scouring the floors.  H*** F*** I better find something good in there.  Something like that gotta be on the top floor."
journal_text_ref = NodePath("../../../../../JournalPanel/JournalLabel")
journal_author_ref = NodePath("../../../../../JournalPanel/AuthorLabel")
journal_panel_ref = NodePath("../../../../../JournalPanel")
clickSound = NodePath("../../../../../ButtonClickSound")
hoverSound = NodePath("../../../../../ButtonHoverSound")
metadata/_custom_type_script = "uid://m1ratefdb4lj"

[node name="entry3" type="Button" parent="Journals/TabContainer/Rogue/Entries" unique_id=98469673 node_paths=PackedStringArray("journal_text_ref", "journal_author_ref", "journal_panel_ref", "clickSound", "hoverSound")]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("7_xruoh")
theme_override_font_sizes/font_size = 32
text = "Entry 3"
autowrap_mode = 2
script = ExtResource("20_q3h1k")
Locked = true
Title = "New Little Guy"
Unlock_Goal = 3
Author = "Renly"
Body = "A little cat found me and brought me to this tavern. Part of me doesn’t really trust them.  The other part of me is seeing what they are bringing back.  I wonder if I can get them to nab some nice stuff for me, maybe I could teach them some of my tricks."
journal_text_ref = NodePath("../../../../../JournalPanel/JournalLabel")
journal_author_ref = NodePath("../../../../../JournalPanel/AuthorLabel")
journal_panel_ref = NodePath("../../../../../JournalPanel")
clickSound = NodePath("../../../../../ButtonClickSound")
hoverSound = NodePath("../../../../../ButtonHoverSound")
metadata/_custom_type_script = "uid://m1ratefdb4lj"

[node name="entry4" type="Button" parent="Journals/TabContainer/Rogue/Entries" unique_id=1567895555 node_paths=PackedStringArray("journal_text_ref", "journal_author_ref", "journal_panel_ref", "clickSound", "hoverSound")]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("7_xruoh")
theme_override_font_sizes/font_size = 32
text = "Entry 4"
autowrap_mode = 2
script = ExtResource("20_q3h1k")
Locked = true
Title = "Impressive"
Unlock_Goal = 5
Author = "Renly"
Body = "That little rascal is really something.  They finessed their way around the tower in a way I could never.  Even better, they have kept bringing back me some shinies to show my friends.  It feels weird though, I didn’t actually steal any of this...  Maybe I stick around and see what I can do for the little rascal."
