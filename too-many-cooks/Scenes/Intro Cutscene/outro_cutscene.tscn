script = ExtResource("1_v8s24")
Subtitles = Array[String](["And so, at last, the Rat King's reign of terror has ended. ", "Reclaiming the vault worth of supplies, our hero gave back to the people of Faunia what was rightfully theirs. ", "The people celebrated the Rat King's defeat by having a celebration in the hero's honor.", "And of course, what is a celebration without a drink? ", "They sang and danced with a joy thought extinct, all throughout the night.", "But, the closest allies to the hero have the largest surprise for them.", "The next morning, the hero was given a cloak that once belonged to a now retired adventurer. ", "A dagger, once used by a great rogue.", "A piece of armor, handed down from a warrior.", "And the rat kings staff, a gift from a mage who tamed the staff's power so it could be used for good.", "Though the people were sad to see them go, the Hero knew their path was beyond the lands of Faunia. ", "Armed with the skills inherited by their comrades, the Hero set off to explore the world and see what other adventures await them.", "Thus concluding The Tale of the Tower,", "but, not The Tale of our Hero..."])
Voice = Array[AudioStream]([ExtResource("2_g8cdt"), ExtResource("3_euqdl"), ExtResource("4_c4wx0"), ExtResource("5_i1clk"), ExtResource("6_ehwip"), ExtResource("7_kdpsf"), ExtResource("8_6n4gi"), ExtResource("9_kh2pc"), ExtResource("10_g15l1"), ExtResource("11_wowq7"), ExtResource("12_s4nyv"), ExtResource("13_m6foe"), ExtResource("14_m0fwq"), ExtResource("15_l56t5")])
